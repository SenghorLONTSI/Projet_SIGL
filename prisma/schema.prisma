model ma {
  id        String     @id
  userId    String     @unique
  name      String
  subName   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  apprenti  apprenti[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model tp {
  id        String     @id
  userId    String     @unique
  name      String
  subName   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  apprenti  apprenti[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JournalTemplate {
  id          Int                 @id @default(autoincrement())
  code        String              @unique
  Titre       String
  periode     String
  description String?
  deadline    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignment  JournalAssignment[]
  slot        JournalSlot?        @relation("TemplateSlots")

  @@map("journal_template")
}

model JournalAssignment {
  id         Int              @id @default(autoincrement())
  templateId Int
  apprentiId String
  statut     AssignmentStatut @default(EN_COURS)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  documents  Document[]
  apprenti   apprenti         @relation(fields: [apprentiId], references: [id])
  template   JournalTemplate  @relation(fields: [templateId], references: [id])
  reviews    Review?          @relation("AssignmentReviews")

  @@map("journal_assignment")
}

model JournalSlot {
  id                Int             @id @default(autoincrement())
  journalTemplateId Int             @unique
  apprentiId        String?
  titre             String
  instruction       String?
  mimeAuthorized    String?
  maxSize           Int?
  dueAt             DateTime?
  isrequired        Boolean         @default(true)
  statut            SlotStatut      @default(PENDING)
  lastsubmissionAt  DateTime?
  nbFiles           Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  documents         Document[]
  apprenti          apprenti?       @relation(fields: [apprentiId], references: [id])
  template          JournalTemplate @relation("TemplateSlots", fields: [journalTemplateId], references: [id])

  @@map("journal_slot")
}

model Review {
  id           Int               @id @default(autoincrement())
  assignmentId Int               @unique
  maId         String
  note         Int?
  commentaire  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignment   JournalAssignment @relation("AssignmentReviews", fields: [assignmentId], references: [id], onDelete: Cascade)
  ma           User              @relation("MAUserReviews", fields: [maId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([maId])
  @@map("review")
}

model Document {
  id                  Int                @id @default(autoincrement())
  journalSlotId       Int?
  journalAssignmentId Int?
  fileName            String
  mimeType            String
  size                Int
  url                 String
  status              DocStatus          @default(UPLOADED)
  createdAt           DateTime           @default(now())
  assignment          JournalAssignment? @relation(fields: [journalAssignmentId], references: [id], onDelete: Cascade)
  slot                JournalSlot?       @relation(fields: [journalSlotId], references: [id], onDelete: Cascade)

  @@map("document")
}

