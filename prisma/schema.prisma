generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

model User {
  id            String    @id
  email         String    @unique
  name          String
  subName       String?
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  apprenti      apprenti?
  ma            ma?
  tp            tp?
  maReviews Review[] @relation("MAUserReviews")


  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  id         Int      @id

  @@map("verification")
}

model apprenti {
  id        String   @id
  userId    String   @unique
  name      String
  subName   String?
  idMA      String?
  idTP      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  ma        ma?      @relation(fields: [idMA], references: [id])
  tp        tp?      @relation(fields: [idTP], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalAssignments JournalAssignment[] 
  journalSlots       JournalSlot[]       
  @@index([idMA])
}

model ma {
  id        String     @id
  userId    String     @unique
  name      String
  subName   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  apprenti  apprenti[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model tp {
  id        String     @id
  userId    String     @unique
  name      String
  subName   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  apprenti  apprenti[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  APPRENTI
  MA
  TP
  CA
  RH
}

enum SlotStatut {
  PENDING
  SUBMITTED
  VALIDATED
  REJECTED
}

enum AssignmentStatut {
  EN_COURS
  TERMINE
  EN_RETARD
}

enum DocStatus {
  UPLOADED
  SUBMITTED
  APPROVED
  REJECTED
}

model JournalTemplate {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  Titre       String
  periode     String
  description String?
  deadline    DateTime?
  slot       JournalSlot?       @relation("TemplateSlots")
  assignment JournalAssignment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("journal_template")
}

model JournalAssignment {
  id         Int              @id @default(autoincrement())
  templateId Int
  apprentiId String
  statut     AssignmentStatut @default(EN_COURS)

  template  JournalTemplate @relation(fields: [templateId], references: [id])
  apprenti  apprenti        @relation(fields: [apprentiId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  documents Document[]
  reviews Review[] @relation("AssignmentReviews")


  @@map("journal_assignment")
}

model JournalSlot {
  id              Int         @id @default(autoincrement())
  journalTemplateId Int         @unique
  apprentiId      String?
  titre           String
  instruction     String?
  mimeAuthorized  String?
  maxSize         Int?
  dueAt           DateTime?
  isrequired      Boolean     @default(true)

  statut          SlotStatut  @default(PENDING)
  lastsubmissionAt DateTime?
  nbFiles         Int         @default(0)

  template        JournalTemplate @relation("TemplateSlots", fields: [journalTemplateId], references: [id])
  apprenti        apprenti?       @relation(fields: [apprentiId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  documents      Document[]
  @@map("journal_slot")
}

model Review{
  id Int                                  @id @default(autoincrement())
  assignmentId Int
  maId String 
  note Int? 
  commentaire String?
  createdAt DateTime                      @default(now())
  updatedAt DateTime                      @updatedAt
  assignment JournalAssignment            @relation("AssignmentReviews", fields: [assignmentId], references: [id], onDelete: Cascade)
  ma User                                 @relation("MAUserReviews", fields: [maId], references: [id], onDelete: Cascade)


  @@index([assignmentId])
  @@index([maId])
  @@map("review")
}
model Document {
  id Int @id @default(autoincrement())

  // lier EITHER à un slot, OR directement à l’affectation (journal sans slots)
  journalSlotId       Int?
  journalAssignmentId Int?

  slot       JournalSlot?       @relation(fields: [journalSlotId], references: [id], onDelete: Cascade)
  assignment JournalAssignment? @relation(fields: [journalAssignmentId], references: [id], onDelete: Cascade)

  fileName String
  mimeType String
  size     Int
  url      String

  status    DocStatus @default(UPLOADED)
  createdAt DateTime  @default(now())

  @@map("document")
}
